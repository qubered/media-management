{
	"name": "companion-module-lectern",
	"version": "0.1.0",
	"main": "dist/main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"format": "prettier -w .",
		"package": "npm run build && companion-module-build",
		"build": "rimraf dist && npm run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "npm run lint:raw ."
	},
	"license": "MIT",
	"engines": {
		"node": "^22.20"
	},
	"dependencies": {
		"@companion-module/base": "^2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.2",
		"@types/node": "^22",
		"eslint": "^9",
		"prettier": "^3",
		"rimraf": "^6",
		"typescript": "~5.9",
		"typescript-eslint": "^8"
	},
	"prettier": "@companion-module/tools/.prettierrc.json"
}
